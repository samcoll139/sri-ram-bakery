# Backend API (Express + MongoDB — see /backend)
VITE_API_BASE_URL=http://localhost:8080/api

# Reviews
VITE_GOOGLE_REVIEW_URL=

# Social / contact links
VITE_INSTAGRAM_URL=
VITE_FACEBOOK_URL=
VITE_WHATSAPP_URL=

# Shop location (demo coordinates for central Chennai — replace with your
# actual shop's coordinates). VITE_GOOGLE_MAPS_URL opens full Google Maps
# for directions (used by the footer/sidebar "Google Maps" link — this
# works fine as a normal link). VITE_GOOGLE_MAPS_EMBED_URL is an
# OpenStreetMap embed for the Contact page map — OpenStreetMap is used here
# instead of Google's iframe embed because Google blocks iframe embedding
# without a paid API key, while OpenStreetMap embeds reliably with no key
# needed at all.
VITE_GOOGLE_MAPS_URL=https://www.google.com/maps/search/?api=1&query=142+Gandhi+Bazaar+Main+Road+Chennai+Tamil+Nadu+600004
VITE_GOOGLE_MAPS_EMBED_URL=https://www.openstreetmap.org/export/embed.html?bbox=80.2607%2C13.0777%2C80.2807%2C13.0877&layer=mapnik&marker=13.0827%2C80.2707
